{
  "name": "asra-joseon-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:graphics": "vite-node scripts/generate_graphics_coverage.ts && python3 scripts/audit_monster_atlases.py",
    "audit:routes": "vite-node scripts/generate_field_connection_audit.ts",
    "audit:monsters": "python3 scripts/audit_monster_atlases.py --check",
    "build:world-charms": "python3 scripts/build_world_charms.py",
    "validate:world-charms": "python3 scripts/validate_world_charms.py",
    "build:world-bows": "python3 scripts/build_world_bows.py",
    "validate:world-bows": "python3 scripts/validate_world_bows.py",
    "build:regional-armors": "python3 scripts/build_regional_armor_layers.py",
    "validate:regional-armors": "python3 scripts/validate_regional_armor_layers.py",
    "build:monster-variants": "python3 scripts/build_monster_faction_variants.py",
    "validate:monster-variants": "python3 scripts/validate_monster_faction_variants.py",
    "build:elemental-fx": "python3 scripts/build_elemental_impact_atlas.py",
    "validate:elemental-fx": "python3 scripts/validate_elemental_impact_atlas.py",
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/prune_dist_assets.mjs && node scripts/build_guide_host.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
